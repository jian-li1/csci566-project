{
  "output_dir": "outputs",
  "generation": {
    "max_new_tokens": 4096,
    "seed": 42
  },
  "grader": {
    "runtime": "docker",
    "image": "project-eval-grader:1",
    "timeout_seconds": 20
  },
  "runs": [
    {
      "name": "qwen_kodcode_base_sft",
      "task": "kodcode",
      "checkpoint": {
        "type": "adapter",
        "path": "checkpoints/qwen_kodcode_base_sft",
        "base_model": "Qwen/Qwen3.5-4B-Base",
        "base_revision": "1001bb4d826a52d1f399e183466143f4da7b741b",
        "loader": "qwen3_5_text"
      },
      "prompt": {
        "format": "base",
        "base_template": "### Instruction:\n{question}\n\nReturn a complete Python solution in a single fenced code block.\n\n### Response:\n",
        "add_bos": true,
        "include_signatures": false
      },
      "device": "cuda",
      "dtype": "bfloat16",
      "offline": false
    }
  ]
}
