{
  "output_dir": "outputs",
  "generation": {
    "max_new_tokens": 4096,
    "seed": 42
  },
  "grader": {
    "runtime": "docker",
    "image": "project-eval-grader:1",
    "timeout_seconds": 20
  },
  "runs": [
    {
      "name": "llama_kodcode_sft",
      "task": "kodcode",
      "checkpoint": {
        "type": "adapter",
        "path": "checkpoints/llama_kodcode_sft",
        "base_model": "meta-llama/Llama-3.2-3B-Instruct",
        "base_revision": "0cb88a4f764b7a12671c53f0838cd831a0843b95",
        "loader": "auto_causal"
      },
      "prompt": {
        "format": "chat",
        "include_signatures": true,
        "chat_template_kwargs": {
          "date_string": "26 Jul 2024"
        }
      },
      "device": "cuda",
      "dtype": "bfloat16",
      "offline": false
    }
  ]
}
